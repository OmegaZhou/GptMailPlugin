[Unit]
Description=GptMail hosted IMAP/SMTP MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gpt-mail
Group=gpt-mail
WorkingDirectory=/opt/gpt-mail/current
ExecStart=/usr/local/bin/node /opt/gpt-mail/current/server.cjs
Environment=NODE_ENV=production
Environment=MAIL_SERVER_CONFIG=/etc/gpt-mail/config.json
Environment=MAIL_STATE_DIR=/var/lib/gpt-mail
Environment=MAIL_BIND_HOST=127.0.0.1
Environment=PORT=18082
EnvironmentFile=-/etc/gpt-mail/mail.env
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gpt-mail
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
