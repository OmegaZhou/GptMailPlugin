    {
      "name": "search_emails",
      "description": "Search one folder, returning headers and stable cursor pagination. Default folder is INBOX; order is descending mailbox UID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": {
            "description": "Configured account ID; optional when a default is configured.",
            "type": "string",
            "maxLength": 64
          },
          "query": {
            "default": "",
            "description": "Subset: from:, to:, cc:, bcc:, subject:, body:, after:YYYY-MM-DD (inclusive), before:YYYY-MM-DD, newer_than:Nd/Nw, is:unread/read/starred/draft, in:/label: exact folder. Quoted phrases. No has:attachment, boolean, negation or Gmail categories.",
            "type": "string",
            "maxLength": 4000
          },
          "mailbox": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "mail.read"
            ]
          }
        ]
      },
      "securitySchemes": [
        {
