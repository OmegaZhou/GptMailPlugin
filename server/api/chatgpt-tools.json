    {
      "name": "create_draft",
      "description": "Save an unsent server-side draft. HTML/text and binary attachments supported; reply_message_id supplies reply headers and default recipient.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": {
            "description": "Configured account ID; optional when a default is configured.",
            "type": "string",
            "maxLength": 64
          },
          "to": {
            "type": "string",
            "maxLength": 8000
          },
          "cc": {
            "type": "string",
            "maxLength": 8000
          },
          "bcc": {
            "type": "string",
            "maxLength": 8000
          },
          "subject": {
            "default": "",
            "type": "string",
            "maxLength": 8000
          },
          "text": {
            "type": "string",
            "maxLength": 5242880
          },
          "html": {
            "type": "string",
            "maxLength": 5242880
          },
          "attachments": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "content_type": {
                  "default": "application/octet-stream",
                  "type": "string",
                  "pattern": "^[\\w.+-]+\\/[\\w.+-]+$"
                },
                "base64_url_content": {
                  "type": "string",
                  "maxLength": 36700160,
                  "pattern": "^[A-Za-z0-9_-]*$"
                },
                "content_id": {
                  "type": "string",
                  "maxLength": 8000
                }
              },
              "required": [
                "filename",
                "base64_url_content"
              ],
              "additionalProperties": false
            }
          },
          "reply_message_id": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
