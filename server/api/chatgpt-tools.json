            "type": "string",
            "maxLength": 5242880
          },
          "attachments": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "content_type": {
                  "default": "application/octet-stream",
                  "type": "string",
                  "pattern": "^[\\w.+-]+\\/[\\w.+-]+$"
                },
                "base64_url_content": {
                  "type": "string",
                  "maxLength": 36700160,
                  "pattern": "^[A-Za-z0-9_-]*$"
                },
                "content_id": {
                  "type": "string",
                  "maxLength": 8000
                }
              },
              "required": [
                "filename",
                "base64_url_content"
              ],
              "additionalProperties": false
            }
          },
          "reply_message_id": {
            "type": "string",
            "maxLength": 4096
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Unique UUID for this send intent. Reuse for retries with identical content; never reuse for different mail."
          }
