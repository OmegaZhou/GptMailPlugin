{
  "storageKey": "",
  "oauth": {
    "enabled": true,
    "mcpPath": "/mail-mcp",
    "routePrefix": "/mail-mcp",
    "provider": {
      "issuer": "https://mail.example.com/mailauth",
      "jwksUrl": "https://mail.example.com/mailauth/jwks.json",
      "resource": "https://mail.example.com/mail-mcp",
      "clientId": "gptmail-chatgpt",
      "allowedSubjects": ["REPLACE_WITH_AUTHENTICATED_OWNER_SUBJECT"]
    }
  },
  "http": {
    "publicUrl": "https://mail.example.com",
    "bindHost": "127.0.0.1",
    "port": 3000,
    "trustProxy": 0,
    "allowedOrigins": []
  },
  "mail": {
    "defaultAccount": "qq",
    "accounts": [
      {
        "id": "qq", "email": "your-number@qq.com",
        "imap": { "host": "imap.qq.com", "port": 993, "secure": true, "passwordEnv": "QQ_MAIL_PASSWORD" },
        "smtp": { "host": "smtp.qq.com", "port": 465, "secure": true, "passwordEnv": "QQ_MAIL_PASSWORD" },
        "saveSent": true
      }
    ],
    "maxMessageBytes": 26214400
  }
