{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "gpt-mail",
  "version": "0.5.5",
  "description": "通用 IMAP/SMTP 邮箱：多账号、搜索、阅读、附件、草稿、发送、回复、转发和邮件整理。",
  "author": {
    "name": "GptMail Contributors"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "GptMail",
        "shortDescription": "多账号邮箱搜索、收发与整理",
        "longDescription": "登录服务器账号后，在 ChatGPT 内管理多个 IMAP/SMTP 邮箱。连接自动恢复，无需再次填写服务器地址或密钥。",
        "developerName": "GptMail Contributors",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
        "defaultPrompt": [
          "帮我查看最近的未读邮件。",
          "为这封邮件起草回复。",
          "帮我整理收件箱。"
        ]
      },
      "mcpServers": "./mcp.json"
    }
  }
}
